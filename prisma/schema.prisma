generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// TENANT
// ==========================================================

// Empresa cliente da plataforma. Fundação da multi-locação: cada linha das
// tabelas "por tenant" abaixo pertence a exatamente um Tenant. Nessa etapa
// a coluna tenantId só existe no schema — nenhuma query ainda filtra por
// ela (isso vem numa etapa seguinte, via Prisma Client Extension). Os campos
// tenantId têm @default() apontando pro tenant único de hoje só pra manter
// os repositórios existentes compilando/funcionando sem alteração — remover
// esse default quando os repositórios passarem a preencher tenantId
// explicitamente a partir do client escopado por request.
model Tenant {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  active Boolean @default(true)

  users            User[]
  roles            Role[]
  customers        Customer[]
  categories       Category[]
  tags             Tag[]
  slaRules         SlaRule[]
  tickets          Ticket[]
  appointments     Appointment[]
  integrations     Integration[]
  totalChatConfigs TotalChatConfig[]
  chErpConfigs     ChErpConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

// Conta do dono da plataforma (operador da SaaS, não de um tenant). Fica
// deliberadamente FORA do sistema Tenant/User/Role: sem tenantId, sem
// RoleName, não participa da matriz de permissões por tela. Autenticação
// completamente separada — ver middlewares/superAdminAuth.ts. Nunca deve
// entrar em TENANT_SCOPED_MODELS (utils/tenantPrisma.ts): não tem tenantId,
// a extension quebraria tentando injetar um.
model SuperAdmin {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("super_admins")
}

// ==========================================================
// ENUMS
// ==========================================================

enum RoleName {
  ADMINISTRADOR
  GERENTE
  SUPORTE
  IMPLANTACAO
  VISUALIZACAO
}

enum TicketStatus {
  NOVO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  AGUARDANDO_TERCEIRO
  RESOLVIDO
  ENCERRADO
}

enum TicketPriority {
  BAIXA
  NORMAL
  ALTA
  CRITICA
}

enum TicketOrigin {
  MANUAL
  TOTALCHAT
}

enum AppointmentType {
  SUPORTE
  IMPLANTACAO
  TREINAMENTO
  REUNIAO
  VISITA_TECNICA
  RETORNO_CLIENTE
  INTERNO
}

enum CommentVisibility {
  INTERNO
  CLIENTE
}

enum NotificationType {
  CHAMADO_ATRIBUIDO
  RESPONSAVEL_ALTERADO
  MENCAO_COMENTARIO
  SLA_PROXIMO_VENCIMENTO
  SLA_VENCIDO
  EVENTO_AGENDA_PROXIMO
  CHAMADO_ATUALIZADO
}

enum IntegrationProvider {
  TOTALCHAT
  KNOWLEDGE_BASE
  CH_ERP
}

enum IntegrationStatus {
  AGUARDANDO_CONFIGURACAO
  CONECTADO
  ERRO
}

// ==========================================================
// USERS / ROLES / PERMISSIONS
// ==========================================================

model Role {
  id          String       @id @default(uuid())
  name        RoleName
  description String?
  permissions Permission[]
  users       User[]

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cada tenant tem sua própria linha por RoleName (ver TENANT no topo do
  // arquivo) — precisa ser composta com tenantId pra dois tenants poderem
  // ter, cada um, um ADMINISTRADOR/GERENTE/etc próprio.
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?
  roles       Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  jobTitle     String?
  avatarUrl    String?
  active       Boolean @default(true)

  // Vínculo opcional com o atendente correspondente no TotalChat (id numérico da API).
  totalchatAttendantId String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  assignedTickets      Ticket[]        @relation("TicketAssignee")
  createdTickets       Ticket[]        @relation("TicketCreator")
  ticketComments       TicketComment[]
  ticketHistoryEntries TicketHistory[]
  appointments         Appointment[]
  notifications        Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, totalchatAttendantId])
  @@index([tenantId])
  @@map("users")
}

// ==========================================================
// CUSTOMERS
// ==========================================================

model Customer {
  id          String  @id @default(uuid())
  companyName String
  tradeName   String?
  cnpj        String?
  phone       String?
  email       String?
  city        String?
  notes       String?

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  contacts     CustomerContact[]
  tickets      Ticket[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@map("customers")
}

// Estrutura preparada para futuramente relacionar o contato à conversa do TotalChat.
model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  totalchatContactId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_contacts")
}

// ==========================================================
// CATEGORIES / TAGS
// ==========================================================

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  tickets     Ticket[]

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model Tag {
  id      String      @id @default(uuid())
  name    String
  tickets TicketTag[]

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model TicketTag {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@map("ticket_tags")
}

// ==========================================================
// SLA
// ==========================================================

model SlaRule {
  id              String         @id @default(uuid())
  priority        TicketPriority
  responseTimeMin Int
  tickets         Ticket[]

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, priority])
  @@index([tenantId])
  @@map("sla_rules")
}

// ==========================================================
// TICKETS
// ==========================================================

model Ticket {
  id          String @id @default(uuid())
  number      Int    @unique @default(autoincrement())
  title       String
  description String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])

  creatorId String?
  creator   User?   @relation("TicketCreator", fields: [creatorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(NOVO)
  origin   TicketOrigin   @default(MANUAL)

  slaRuleId String?
  slaRule   SlaRule?  @relation(fields: [slaRuleId], references: [id])
  slaDueAt  DateTime?

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Campos estruturais para futura integração com o TotalChat.
  // Não preenchidos até que a integração real seja implementada.
  totalchatConversationId  String?
  totalchatMessageId       String?
  totalchatContactId       String?
  totalchatConversationUrl String?

  resolvedProblem String?
  rootCause       String?
  appliedSolution String?
  observations    String?

  resolvedAt DateTime?
  closedAt   DateTime?

  tags        TicketTag[]
  comments    TicketComment[]
  history     TicketHistory[]
  attachments TicketAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tickets")
}

model TicketComment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  content    String
  visibility CommentVisibility @default(INTERNO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_comments")
}

model TicketHistory {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  action    String
  fieldName String?
  oldValue  String?
  newValue  String?

  createdAt DateTime @default(now())

  @@map("ticket_history")
}

model TicketAttachment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fileName  String
  fileUrl   String
  mimeType  String?
  sizeBytes Int?

  createdAt DateTime @default(now())

  @@map("ticket_attachments")
}

// ==========================================================
// AGENDA
// ==========================================================

model Appointment {
  id String @id @default(uuid())

  title       String
  type        AppointmentType
  description String?
  notes       String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id])

  startsAt DateTime
  endsAt   DateTime

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("appointments")
}

// ==========================================================
// NOTIFICATIONS
// ==========================================================

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String?
  readAt  DateTime?

  relatedTicketId      String?
  relatedAppointmentId String?
  relatedUrl           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

// ==========================================================
// INTEGRATIONS (metadata apenas — sem credenciais reais ainda)
// ==========================================================

model Integration {
  id       String              @id @default(uuid())
  provider IntegrationProvider
  status   IntegrationStatus   @default(AGUARDANDO_CONFIGURACAO)
  notes    String?

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("integrations")
}

// Configuração das credenciais do TotalChat, editável em Configurações.
// Linha única (singleton). password fica criptografado (ver utils/crypto.ts) —
// nunca é devolvido em texto plano pela API depois de salvo.
model TotalChatConfig {
  id                  String  @id @default(uuid())
  apiUrl              String?
  username            String?
  password            String?
  connectionId        Int?
  whatsappCloudApiFid Int?
  pollingEnabled      Boolean @default(false)
  pollIntervalSeconds Int     @default(60)

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("totalchat_config")
}

// Configuração da conexão com a base própria do ERP (CH / Integrador BI),
// usada pra importar cadastros de cliente. Linha única (singleton). token
// fica criptografado (ver utils/crypto.ts) — nunca é devolvido em texto
// plano pela API depois de salvo.
model ChErpConfig {
  id            String  @id @default(uuid())
  baseUrl       String?
  token         String?
  cnpjPrincipal String?
  chaveEmpresa  Int     @default(1)

  tenantId String @default("4994caa6-429e-47ae-b6db-c82fe6e0ce13")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("ch_erp_config")
}
