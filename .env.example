# ==============================
# RT HELPDESK - Environment Vars
# ==============================

# ---- Database ----
POSTGRES_USER=rthelpdesk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rthelpdesk
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rthelpdesk:changeme@localhost:5432/rthelpdesk?schema=public

# ---- Backend ----
NODE_ENV=development
PORT=3333
JWT_SECRET=changeme-super-secret-key
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# URL pública onde este backend está acessível (ex.: https://helpdesk.empresa.com.br).
# Necessária só para enviar templates de WhatsApp com imagem no cabeçalho (a Meta busca
# a imagem depois, de forma assíncrona, por isso precisa ser uma URL realmente pública).
# Não funciona a partir de localhost em desenvolvimento — deixe em branco nesse caso.
APP_PUBLIC_URL=

# ---- Frontend ----
VITE_API_URL=http://localhost:3333/api

# ---- TotalChat ----
TOTALCHAT_API_URL=https://api.totalchat.com.br/
TOTALCHAT_USERNAME=
TOTALCHAT_PASSWORD=
# ConexaoId padrão (v1/Contato/GetConexoes) usado para criar clientes/enviar mensagens.
# Deixe em branco para usar automaticamente a conexão marcada como "isPrincipal".
TOTALCHAT_CONNECTION_ID=
# Liga o job de sincronização automática de chamados (polling). Deixe "false" até confirmar login.
TOTALCHAT_POLLING_ENABLED=false
TOTALCHAT_POLL_INTERVAL_SECONDS=60

# ---- Base de Conhecimento (site Gestão — https://gestaoconsultorias.fly.dev) ----
# Sem essas duas variáveis, a tela usa dados mockados automaticamente.
KNOWLEDGE_BASE_API_URL=https://gestaoconsultorias.fly.dev
KNOWLEDGE_BASE_API_KEY=
