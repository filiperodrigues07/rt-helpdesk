{
  "name": "rt-helpdesk",
  "version": "0.1.0",
  "private": true,
  "description": "RT HELPDESK - Sistema interno de gestão de suporte e implantação de ERP",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
